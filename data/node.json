{
  "id": "h1AhBG0r8zPvXkrb",
  "name": "Marketing Campaigns Funnel - Notion Integration",
  "nodes": [
    {
      "parameters": {
        "content": "## Marketing Campaigns Database Setup\n1. **Webhook** \u2013 POST endpoint `/webhook/lead-magnet-signup` receives new Marketing Campaign submissions.\n2. **Notion** \u2013 Connected to `Marketing_Campaigns_Database` (ID: `3a875e373f5480918a8eec701d1fe5d4`). Matches properties: `Campaign name` (title), `Channel` (select), `Status` (select), `Monthly Budget` (number), `Start Date` (date).\n3. **Email (x2)** \u2013 Sends campaign launch notifications and team alerts.\n4. Toggle workflow **Active** once credentials are set.",
        "height": 320,
        "width": 460,
        "color": 5
      },
      "id": "166a6b95-b227-405c-98cc-699f8bfea4ca",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        240,
        40
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-magnet-signup",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "69bfaaab-5e37-4e5a-93f3-3115f00dc056",
      "name": "Lead Form Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "66e0093f-055d-478d-9ae8-f0515ed73bc5"
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "19ba71d3-3385-4b00-b4b5-5734e263abdc",
              "name": "campaign_name",
              "value": "={{ $json.body.campaign_name || $json.body.name }}",
              "type": "string"
            },
            {
              "id": "4c35c410-eb33-4104-97a6-1ecfccc7ca6d",
              "name": "channel",
              "value": "={{ $json.body.channel || 'Paid Social' }}",
              "type": "string"
            },
            {
              "id": "4c044f5c-4eaf-4065-86d6-404272a0e43d",
              "name": "status",
              "value": "={{ $json.body.status || 'Active' }}",
              "type": "string"
            },
            {
              "id": "35f9e96e-d523-4923-b990-4e7413819881",
              "name": "monthly_budget",
              "value": "={{ Number($json.body.monthly_budget || $json.body.budget || 4000) }}",
              "type": "number"
            },
            {
              "id": "76f9e96e-d523-4923-b990-4e7413819882",
              "name": "start_date",
              "value": "={{ $json.body.start_date || '2026-01-07' }}",
              "type": "string"
            },
            {
              "id": "86f9e96e-d523-4923-b990-4e7413819883",
              "name": "submittedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c2e5c6e5-6899-40d8-83e8-cece7e44734c",
      "name": "Normalize Campaign Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "databaseId": {
          "__rl": true,
          "value": "3a875e373f5480918a8eec701d1fe5d4",
          "mode": "id"
        },
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Campaign name|title",
              "title": "={{ $json.campaign_name }}"
            },
            {
              "key": "Channel|select",
              "selectValue": "={{ $json.channel }}"
            },
            {
              "key": "Status|select",
              "selectValue": "={{ $json.status }}"
            },
            {
              "key": "Monthly Budget|number",
              "numberValue": "={{ $json.monthly_budget }}"
            },
            {
              "key": "Start Date|date",
              "date": "={{ $json.start_date }}"
            }
          ]
        },
        "options": {}
      },
      "id": "965661ea-3c15-42e8-88fd-a0d2d2ff6ad8",
      "name": "Log Campaign to Notion",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        760,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "fromEmail": "you@yourbusiness.com",
        "toEmail": "marketing@mydomain.com",
        "subject": "=🚀 New Campaign Created: {{ $json.campaign_name }}",
        "emailFormat": "html",
        "html": "=<p>Hi Team,</p><p>A new marketing campaign has been created:</p><ul><li><strong>Campaign Name:</strong> {{ $json.campaign_name }}</li><li><strong>Channel:</strong> {{ $json.channel }}</li><li><strong>Status:</strong> {{ $json.status }}</li><li><strong>Monthly Budget:</strong> ${{ $json.monthly_budget }}</li><li><strong>Start Date:</strong> {{ $json.start_date }}</li></ul><p>Logged to Notion Marketing_Campaigns_Database.</p>",
        "options": {}
      },
      "id": "c6517ca4-4e98-4871-b634-e430765bbb78",
      "name": "Deliver Campaign Confirmation Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1020,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "fromEmail": "you@yourbusiness.com",
        "toEmail": "sales@mydomain.com",
        "subject": "=🚨 Marketing Campaign Alert: {{ $json.campaign_name }}",
        "emailFormat": "html",
        "html": "=<p>Hi Team,</p><p>New campaign registered in Notion!</p><p><strong>Campaign:</strong> {{ $json.campaign_name }} ({{ $json.channel }}) — Budget: ${{ $json.monthly_budget }}</p>",
        "options": {}
      },
      "id": "8f2c30a1-42f3-4ade-8f51-c1d5c11b3e8e",
      "name": "Notify Sales Team (Email)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1280,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "fromEmail": "you@yourbusiness.com",
        "toEmail": "marketing@mydomain.com",
        "subject": "=Campaign Activation Checklist: {{ $json.campaign_name }}",
        "emailFormat": "html",
        "html": "=<p>Hi Marketing Team,</p><p>Here is your activation checklist for campaign {{ $json.campaign_name }}.</p>",
        "options": {}
      },
      "id": "4413d015-7d99-4083-8b91-ce0cbdb8607e",
      "name": "Send Campaign Follow-up Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1540,
        300
      ],
      "continueOnFail": true
    }
  ],
